{
  "appId": "org.sundayschool.attendance",
  "appName": "تي اكليسيا",
  "webDir": "www",
  "backgroundColor": "#0A2A4F",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
